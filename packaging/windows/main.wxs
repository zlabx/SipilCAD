<?xml version='1.0' encoding='UTF-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='SipilCAD'
    UpgradeCode='283c746d-d1c4-5e05-9422-ace7311cec6a'
    Manufacturer='SipilStock'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package
      Id='*'
      Keywords='!(loc.Installer)'
      Description='!(loc.InstallerDescription)'
      Manufacturer='SipilStock'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      InstallScope='perMachine'
      SummaryCodepage='1252' />

    <MajorUpgrade
      Schedule='afterInstallInitialize'
      AllowSameVersionUpgrades='yes'
      DowngradeErrorMessage='!(loc.DowngradeError)' />

    <Media Id='1' Cabinet='product.cab' EmbedCab='yes' />

    <Icon Id='AppIcon.ico' SourceFile='$(var.Icon)' />
    <Property Id='ARPPRODUCTICON' Value='AppIcon.ico' />
    <Property Id='ARPHELPLINK' Value='https://sipilstock.com/sipilcad/' />
    <Property Id='ARPURLINFOABOUT' Value='https://sipilstock.com/sipilcad/' />
    <Property Id='ARPURLUPDATEINFO' Value='https://sipilstock.com/sipilcad/' />
    <Property Id='ARPCONTACT' Value='SipilStock' />
    <Property Id='ARPCOMMENTS' Value='!(loc.ApplicationDescription)' />
    <Property Id='ARPNOREPAIR' Value='1' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONROOTDIRECTORY' Name='SipilCAD'>

          <Component Id='MainExecutable' Guid='2e67ca47-3069-5a8f-9720-4e2f2060d64b' Win64='yes'>
            <File
              Id='SipilCADEXE'
              Name='SipilCAD.exe'
              DiskId='1'
              Source='$(var.Source)'
              KeyPath='yes'>
              <Shortcut
                Id='StartMenuShortcut'
                Directory='ProgramMenuDir'
                Name='SipilCAD'
                Description='!(loc.Launch)'
                WorkingDirectory='APPLICATIONROOTDIRECTORY'
                Icon='AppIcon.ico'
                IconIndex='0'
                Advertise='yes' />
            </File>
            <File Id='DwgIco' Name='dwg.ico' DiskId='1' Source='packaging\windows\dwg.ico' />
            <File Id='DxfIco' Name='dxf.ico' DiskId='1' Source='packaging\windows\dxf.ico' />
            <File
              Id='DwgThumbDll'
              Name='dwg_thumbnailer_win.dll'
              DiskId='1'
              Source='target\release\dwg_thumbnailer_win.dll' />
            <File Id='LicenseTxt' Name='LICENSE.txt' DiskId='1' Source='$(var.Docs)\LICENSE.txt' />
            <File Id='SourceTxt' Name='SOURCE.txt' DiskId='1' Source='$(var.Docs)\SOURCE.txt' />
            <File Id='ThirdPartyLicensesTxt' Name='THIRD_PARTY_LICENSES.txt' DiskId='1' Source='$(var.Docs)\THIRD_PARTY_LICENSES.txt' />
            <File Id='OflPtSansTxt' Name='OFL-PTSans.txt' DiskId='1' Source='$(var.Docs)\OFL-PTSans.txt' />
            <ProgId
              Id='SipilCAD.DWG'
              Description='!(loc.DwgDrawing)'
              Icon='DwgIco'
              IconIndex='0'>
              <Extension Id='dwg' ContentType='image/vnd.dwg'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='SipilCADEXE' Argument='"%1"' />
              </Extension>
            </ProgId>

            <ProgId
              Id='SipilCAD.DXF'
              Description='!(loc.DxfDrawing)'
              Icon='DxfIco'
              IconIndex='0'>
              <Extension Id='dxf' ContentType='image/vnd.dxf'>
                <Verb Id='open' Command='!(loc.Open)' TargetFile='SipilCADEXE' Argument='"%1"' />
              </Extension>
            </ProgId>
          </Component>
          <Component Id='DefaultPrograms' Guid='e1eacc21-069d-5fcc-8ab6-a5d3cae687c1' Win64='yes'>
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SipilCAD.exe\DefaultIcon'
              Type='string'
              Value='[APPLICATIONROOTDIRECTORY]SipilCAD.exe,0'
              KeyPath='yes' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SipilCAD.exe'
              Name='FriendlyAppName'
              Type='string'
              Value='SipilCAD' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SipilCAD.exe\shell\open\command'
              Type='string'
              Value='"[APPLICATIONROOTDIRECTORY]SipilCAD.exe" "%1"' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SipilCAD.exe\SupportedTypes'
              Name='.dwg'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Classes\Applications\SipilCAD.exe\SupportedTypes'
              Name='.dxf'
              Type='string'
              Value='' />
            <RegistryValue
              Root='HKLM'
              Key='Software\SipilCAD\Capabilities'
              Name='ApplicationName'
              Type='string'
              Value='SipilCAD' />
            <RegistryValue
              Root='HKLM'
              Key='Software\SipilCAD\Capabilities'
              Name='ApplicationDescription'
              Type='string'
              Value='!(loc.ApplicationDescription)' />
            <RegistryValue
              Root='HKLM'
              Key='Software\SipilCAD\Capabilities\FileAssociations'
              Name='.dwg'
              Type='string'
              Value='SipilCAD.DWG' />
            <RegistryValue
              Root='HKLM'
              Key='Software\SipilCAD\Capabilities\FileAssociations'
              Name='.dxf'
              Type='string'
              Value='SipilCAD.DXF' />
            <RegistryValue
              Root='HKLM'
              Key='Software\RegisteredApplications'
              Name='SipilCAD'
              Type='string'
              Value='Software\SipilCAD\Capabilities' />
          </Component>

        </Directory>
      </Directory>

      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ProgramMenuDir' Name='SipilCAD'>
          <Component Id='ProgramMenuDirComp' Guid='54e59ef4-aa3b-5cfa-afc9-8996d03362f7'>
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue
              Root='HKCU'
              Key='Software\SipilCAD'
              Name='installed'
              Type='integer'
              Value='1'
              KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>
      <Directory Id='DesktopFolder' Name='!(loc.Desktop)'>
        <Component Id='DesktopShortcutComp' Guid='10b21d43-b3f3-5a75-9c67-329f21fe12f5'>
          <Shortcut
            Id='DesktopShortcut'
            Name='SipilCAD'
            Description='!(loc.Launch)'
            Target='[APPLICATIONROOTDIRECTORY]SipilCAD.exe'
            WorkingDirectory='APPLICATIONROOTDIRECTORY'
            Icon='AppIcon.ico'
            IconIndex='0' />
          <RegistryValue
            Root='HKCU'
            Key='Software\SipilCAD'
            Name='desktop_shortcut'
            Type='integer'
            Value='1'
            KeyPath='yes' />
        </Component>
      </Directory>
    </Directory>

    <Feature Id='Complete' Title='SipilCAD' Level='1' Display='expand'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='DefaultPrograms' />
      <ComponentRef Id='ProgramMenuDirComp' />
      <Feature
        Id='DesktopShortcut'
        Title='!(loc.DesktopShortcut)'
        Description='!(loc.DesktopShortcutDescription)'
        Level='1'
        Absent='allow'>
        <ComponentRef Id='DesktopShortcutComp' />
      </Feature>
    </Feature>
    <UIRef Id='SipilCADUI' />

  </Product>
</Wix>
